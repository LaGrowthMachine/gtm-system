    "POSITIVE": ["interested", "int[ée]ress[ée]", "positive", "positif", "meeting", "rdv", "demo", "d[ée]mo", "call booked", "booked", "\\byes\\b", "\\boui\\b", "\\bhot\\b", "qualified", "qualifi[ée]", "\\bwon\\b", "opportunity", "wants? to talk", "send (me )?more", "envoie", "let'?s talk", "curious"],
